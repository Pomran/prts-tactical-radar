# Environment variables for PRTS Tactical Radar (local development)
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Gaode (AMap) WebService REST API key
# Used by the Cloudflare Worker for reverse geocoding
# Get one at: https://console.amap.com/
GAODE_KEY="your_gaode_web_service_key"
